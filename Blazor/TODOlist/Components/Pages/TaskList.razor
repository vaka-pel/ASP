@page "/TaskList"
@rendermode InteractiveServer
<h2>TaskList</h2>

<input type="text" placeholder="Новая задача" @bind="desccription"/>
<button @onclick="AddTask">Добавить</button>

<ul>
    @foreach (TODOlist.Task task in list)
    {
        <li>@task.Description</li>
    }
</ul>

@code 
{
    List<TODOlist.Task> list = new List<TODOlist.Task>();

    string desccription = "";
    void AddTask()
    {
        if (!string.IsNullOrEmpty(desccription) && !string.IsNullOrWhiteSpace(desccription))
        {   
            TODOlist.Task task = new TODOlist.Task { Description = desccription,DONE=false };
            if (!list.Contains(task))
            {
                list.Add(task);
            }
           
        }
    }
}
